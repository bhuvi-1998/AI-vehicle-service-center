# Supabase PostgreSQL database configuration
DB_DRIVER=postgresql
DB_HOST=your_supabase_pooler_host
DB_PORT=5432
DB_USER=your_supabase_database_user
DB_PASSWORD=replace_with_your_supabase_database_password
DB_NAME=postgres
DB_SSLMODE=require

# PostgreSQL connection pool settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=10
DB_POOL_STARTUP_TIMEOUT=20

# For local MySQL development, use these settings instead:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_mysql_username
# DB_PASSWORD=replace_with_your_mysql_password
# DB_NAME=vehicle_service_center

# JWT authentication
# Use a unique random secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Email server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_address
SMTP_APP_PASSWORD=your_email_app_password
EMAIL_FROM=your_email_address

# Frontend URLs used in email links
FRONTEND_ADMIN_BASE_URL=http://127.0.0.1:5503/pages
FRONTEND_BASE_URL=http://127.0.0.1:5503/customer-portal

# Token expiry settings
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

# Application environment and CORS settings
APP_ENV=development
CORS_ORIGINS=

# Ollama chatbot provider
# Local development uses your computer's Ollama service.
# Render production: set OLLAMA_MODE=cloud and add the private API key.
OLLAMA_MODE=local
OLLAMA_LOCAL_URL=http://localhost:11434/api/chat
OLLAMA_LOCAL_MODEL=llama3.2:3b
OLLAMA_CLOUD_URL=https://ollama.com/api/chat
OLLAMA_CLOUD_MODEL=gemma4
OLLAMA_API_KEY=replace_with_your_ollama_cloud_api_key
