# MySQL database configuration
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=vehicle_service_center

# JWT authentication
# Use a unique random secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Email server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_address
SMTP_APP_PASSWORD=your_email_app_password
EMAIL_FROM=your_email_address

# Frontend URLs used in email links
FRONTEND_ADMIN_BASE_URL=http://127.0.0.1:5503/pages
FRONTEND_BASE_URL=http://127.0.0.1:5503/customer-portal

# Token expiry settings
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
